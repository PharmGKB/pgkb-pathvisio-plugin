Specification-Vendor: PharmGKB
Implementation-Vendor: PharmGKB

Bundle-SymbolicName: org.pharmgkb.pathvisio.plugin
Bundle-Activator:    org.pharmgkb.pathvisio.plugin.Activator
Bundle-ManifestVersion: 2
Bundle-Version: 1.0.0
Bundle-RequiredExecutionEnvironment: JavaSE-1.8
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version=1.8))"

Import-Package:  \
!apple.laf,\
!com.apple.laf,\
!com.jgoodies.jsdl.common.focus,\
!com.jidesoft.action,\
!com.jidesoft.chart,\
!com.jidesoft.diff,\
!com.jidesoft.docking,\
!com.jidesoft.document,\
!com.jidesoft.editor,\
!com.jidesoft.grid,\
!com.jidesoft.pivot,\
!com.jidesoft.rss,\
!com.jidesoft.shortcut,\
!com.jidesoft.treemap,\
!com.jidesoft.wizard,\
!com.sun.*,\
!jena.test,\
!org.apache.batik.dom.*,\
!org.jvnet.*,\
!org.openjena.riot,\
!sun.*,\
!java.*,\
javax.annotation;bundle-symbolic-name="org.jsr-305";resolution:=optional,\
org.jspecify.annotations;resolution:=optional,\
org.pathvisio.core.*,\
org.pathvisio.desktop,\
org.pathvisio.gui,\
*

-includeresource: \
logback.xml                      = ${pv.classes}/logback.xml,\
pgkb-pathvisio-plugin.properties = ${pv.classes}/pgkb-pathvisio-plugin.properties,\
pgkb-pathvisio.icns              = ${pv.classes}/pgkb-pathvisio.icns,\
org/pharmgkb                     = ${pv.classes}/org/pharmgkb,\
@lib/httpclient.jar,\
@lib/httpcore.jar,\
@lib/jena-core.jar,\
@lib/jena-iri.jar,\
@lib/collections-generic.jar,\
@lib/paxtools-core.jar,\
@lib/jide-oss.jar,\
@lib/jgoodies-common.jar,\
@lib/jgoodies-forms.jar
