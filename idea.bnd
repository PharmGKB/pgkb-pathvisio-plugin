Specification-Vendor: PharmGKB
Implementation-Vendor: PharmGKB

Bundle-SymbolicName: org.pharmgkb.pathvisio.plugin
Bundle-Activator:    org.pharmgkb.pathvisio.plugin.Activator
Bundle-ManifestVersion: 2
Bundle-Version: 1.0.0
Bundle-RequiredExecutionEnvironment: JavaSE-1.8
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version=1.8))"

Import-Package:  \
!apple.laf,\
!com.apple.laf,\
!com.jgoodies.jsdl.common.focus,\
!com.jidesoft.action,\
!com.jidesoft.chart,\
!com.jidesoft.diff,\
!com.jidesoft.docking,\
!com.jidesoft.document,\
!com.jidesoft.editor,\
!com.jidesoft.grid,\
!com.jidesoft.pivot,\
!com.jidesoft.rss,\
!com.jidesoft.shortcut,\
!com.jidesoft.treemap,\
!com.jidesoft.wizard,\
!com.sun.*,\
!jena.test,\
!org.apache.batik.dom.*,\
!org.checkerframework.checker.nullness.qual,\
!org.jvnet.*,\
!org.openjena.riot,\
!sun.*,\
javax.annotation;bundle-symbolic-name="org.jsr-305";resolution:=optional,\
org.jspecify.annotations;resolution:=optional,\
org.pathvisio.core.*,\
org.pathvisio.desktop,\
org.pathvisio.gui,\
*

Include-Resource: \
logback.xml                      = src/main/resources/logback.xml,\
pgkb-pathvisio-plugin.properties = src/main/resources/pgkb-pathvisio-plugin.properties,\
pgkb-pathvisio.icns              = src/main/resources/pgkb-pathvisio.icns,\
org/pharmgkb                     = ../build/tmp/pathvisio/classes/org/pharmgkb,\
@../pgkb-core/lib/httpclient.jar,\
@../pgkb-core/lib/httpcore.jar,\
@../pgkb-core/lib/jaxb-runtime.jar,\
@../pgkb-core/lib/sentry.jar,\
@../pgkb-io-pv/lib/jena-core.jar,\
@../pgkb-io-pv/lib/jena-iri.jar,\
@../pgkb-io-pv/lib/collections-generic.jar,\
@../pgkb-io-pv/lib/paxtools-core.jar,\
@../pgkb-pathvisio-plugin/lib/jide-oss.jar,\
@../pgkb-pathvisio-plugin/lib/jgoodies-common.jar,\
@../pgkb-pathvisio-plugin/lib/jgoodies-forms.jar
