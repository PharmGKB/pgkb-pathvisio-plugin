Bundle-SymbolicName: org.pharmgkb.pathvisio.plugin
Bundle-Activator:    org.pharmgkb.pathvisio.plugin.Activator
Private-Package:     org.pharmgkb.pathvisio.plugin.*
Import-Package:  \
!apple.laf,\
!com.apple.laf,\
!com.stormpath.*,\
!com.sun.java.swing.plaf.windows,\
!de.intarsys.*,\
!de.schlichtherle.*,\
!groovy.lang,\
!javax.jms,\
!javax.mail.*,\
!javax.management,\
!javax.naming,\
!javax.net.*,\
!javax.persistence,\
!javax.servlet.*,\
!java.sql,\
!org.apache.commons.cli,\
!org.apache.lucene.*,\
!org.apache.pdfbox.*,\
!org.apache.poi.*,\
!org.apache.shiro.authz,\
!org.aspectj.lang.*,\
!org.codehaus.commons.compiler,\
!org.codehaus.groovy.*,\
!org.codehaus.janino,\
!org.hibernate.*,\
!org.junit.*,\
!org.pharmgkb.dictionary.*,\
!org.pharmgkb.importer.*,\
!org.pharmgkb.mongo,\
!org.pharmgkb.processor,\
!org.pharmgkb.search,\
!org.pharmgkb.web.*,\
!org.pharmgkb.webapp.*,\
!org.springframework.*,\
!sun.*,\
javax.annotation;version="1.2";resolution:=optional,\
org.pathvisio.core.*,\
org.pathvisio.desktop,\
org.pathvisio.gui,\
*
Include-Resource: \
org/pharmgkb/Global.class=../build/packages/pharmgkb/WEB-INF/classes/org/pharmgkb/Global.class,\
org/pharmgkb/aws=../build/packages/pharmgkb/WEB-INF/classes/org/pharmgkb/aws,\
org/pharmgkb/exception=../build/packages/pharmgkb/WEB-INF/classes/org/pharmgkb/exception,\
org/pharmgkb/hibernate=../build/packages/pharmgkb/WEB-INF/classes/org/pharmgkb/hibernate,\
org/pharmgkb/jackson=../build/packages/pharmgkb/WEB-INF/classes/org/pharmgkb/jackson,\
org/pharmgkb/jsonld=../build/packages/pharmgkb/WEB-INF/classes/org/pharmgkb/jsonld,\
org/pharmgkb/model=../build/packages/pharmgkb/WEB-INF/classes/org/pharmgkb/model,\
org/pharmgkb/pathvisio=../build/packages/pharmgkb/WEB-INF/classes/org/pharmgkb/pathvisio,\
org/pharmgkb/util=../build/packages/pharmgkb/WEB-INF/classes/org/pharmgkb/util,\
